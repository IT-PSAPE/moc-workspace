{
  "name": "moc-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,workspace,portal -c green,yellow,blue \"npm run dev -w @moc/api\" \"npm run dev -w @moc/workspace\" \"npm run dev -w @moc/portal\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "check:contrast": "node scripts/check-contrast.mjs",
    "shots": "node scripts/shoot.mjs",
    "verify:ui": "node scripts/check-ui-flows.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "playwright": "^1.64.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
