# Copy to apps/api/.env or put these API-only values in the ignored root .env.local.
PORT=3001
NODE_ENV=development
WORKSPACE_URL=http://localhost:5173
API_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Supabase Dashboard -> Project Settings -> API. These stay on the API only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# New sb_secret_... key (or legacy service_role key). NEVER prefix with VITE_.
SUPABASE_SECRET_KEY=
# Connect -> Transaction pooler for Vercel; copy the full URI, URL-encode password.
# Add ?sslmode=verify-full. Remote connections verify the Supabase CA and hostname.
SUPABASE_DATABASE_URL=
# Connect -> Direct connection, or Session pooler if your network is IPv4-only.
# Used by npm run db:migrate. Add ?sslmode=verify-full.
SUPABASE_DATABASE_URL_DIRECT=
SUPABASE_REPORT_BUCKET=moc-reports

# Google client ID and secret are configured in Supabase -> Auth -> Providers.
# Google callback: https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback
# Supabase allowed redirect: http://localhost:5173/api/auth/callback
# Production allowed redirect: https://moc-workspace.vercel.app/api/auth/callback

# Local demo only, used only while SUPABASE_DATABASE_URL and SUPABASE_URL are empty.
DEMO_MODE=true
API_LOCAL_DATA_PATH=data/state.json

# Optional Telegram notifications, server only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_CELL_0=
TELEGRAM_CHAT_SOUND=
TELEGRAM_CHAT_VISUAL_MEDIA=
TELEGRAM_CHAT_DESIGN=
